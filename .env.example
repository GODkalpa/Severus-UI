# ==========================================
# Severus HUD Frontend Configuration
# ==========================================

# Backend API & WebSocket URLs
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_VOICE_BACKEND_URL=ws://localhost:8000/ws/severus

# Supabase (Optional - for Direct Realtime HUD Subscriptions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WebPush VAPID Public Key (Must match backend VAPID_PUBLIC_KEY)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
